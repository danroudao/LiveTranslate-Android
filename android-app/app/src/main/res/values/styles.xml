<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色 AlertDialog（浅色 Apple 主题使用）：白色 squircle + 品牌蓝 -->
    <style name="LightDialogAlert" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="android:windowElevation">12dp</item>
        <item name="colorPrimary">#0071E3</item>
        <item name="colorAccent">#0071E3</item>
        <item name="android:textColorPrimary">#1D1D1F</item>
        <item name="android:textColorSecondary">#86868B</item>
        <item name="buttonBarButtonStyle">@style/LightDialogButton</item>
    </style>

    <style name="LightDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#0071E3</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
